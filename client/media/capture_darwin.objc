// AVFoundation camera capture (macOS and iOS), ScreenCaptureKit screen
// capture (macOS: screen_macos.objc), and TCC permission checks.
#include <TargetConditionals.h>
#import <AVFoundation/AVFoundation.h>
#import <CoreGraphics/CoreGraphics.h>
#import <CoreMedia/CoreMedia.h>
#import <Foundation/Foundation.h>
#if !TARGET_OS_OSX
#import <UIKit/UIKit.h>
#endif
#if TARGET_OS_OSX
#import <IOKit/IOKitLib.h>
#import <AppKit/AppKit.h>
#import <ScreenCaptureKit/ScreenCaptureKit.h>
#endif
#include <stdlib.h>
#include <string.h>
#include "media_darwin.h"

extern void qvGoScreenFrame(uintptr_t handle, void *pb, int64_t us);
extern void qvGoScreenStopped(uintptr_t handle, int code, char *msg);
extern void qvGoCameraFrame(uintptr_t handle, void *pb, int64_t us);
extern void qvGoCameraStopped(uintptr_t handle, char *msg);

static char *nserr(NSString *prefix, NSError *err) {
    NSString *s = err ? [NSString stringWithFormat:@"%@: %@ (%@ %ld)", prefix, err.localizedDescription, err.domain,
                                                   (long)err.code]
                      : prefix;
    return strdup(s.UTF8String);
}

static char *jsonString(id obj) {
    NSData *d = [NSJSONSerialization dataWithJSONObject:obj options:0 error:nil];
    NSString *s = [[NSString alloc] initWithData:d encoding:NSUTF8StringEncoding];
    return strdup(s.UTF8String);
}

static int64_t nowUS(void) { return (int64_t)([[NSDate date] timeIntervalSince1970] * 1e6); }

// ---------------------------------------------------------------- TCC

int qv_camera_access(void) {
    switch ([AVCaptureDevice authorizationStatusForMediaType:AVMediaTypeVideo]) {
    case AVAuthorizationStatusAuthorized:
        return 1;
    case AVAuthorizationStatusNotDetermined:
        return -1;
    default:
        return 0;
    }
}

int qv_camera_request(int timeout_ms) {
    if (qv_camera_access() != -1) return qv_camera_access();
    dispatch_semaphore_t sem = dispatch_semaphore_create(0);
    [AVCaptureDevice requestAccessForMediaType:AVMediaTypeVideo
                             completionHandler:^(BOOL granted) {
                               dispatch_semaphore_signal(sem);
                             }];
    dispatch_semaphore_wait(sem, dispatch_time(DISPATCH_TIME_NOW, (int64_t)timeout_ms * NSEC_PER_MSEC));
    return qv_camera_access();
}

// ---------------------------------------------------------------- screen

#if TARGET_OS_OSX
#include "screen_macos.objc"
#else
// iOS: no screen sharing yet (it needs a ReplayKit broadcast extension).
int qv_screen_access(void) { return -1; }
void qv_screen_request(void) {}
int qv_screen_supported(void) { return 0; }
char *qv_screen_list(char **err) {
    *err = strdup("screen sharing isn't available on this device yet");
    return NULL;
}
qv_screen *qv_screen_start(uint32_t display_id, uint32_t window_id, int width, int height, int max_width, int fps, int show_cursor,
                           uintptr_t handle, char **err) {
    *err = strdup("screen sharing isn't available on this device yet");
    return NULL;
}
void qv_screen_stop(qv_screen *s) {}
unsigned char *qv_app_icon(const char *bundle_id, int size, size_t *len) { return NULL; }
unsigned char *qv_screen_thumbnail(uint32_t display_id, uint32_t window_id, int max_w, size_t *len, char **err) {
    *err = strdup("screen sharing isn't available on this device yet");
    return NULL;
}
#endif

// ---------------------------------------------------------------- camera

static NSArray<AVCaptureDevice *> *cameras(void) {
    NSMutableArray *types = [NSMutableArray arrayWithObject:AVCaptureDeviceTypeBuiltInWideAngleCamera];
#if TARGET_OS_OSX
    if (@available(macOS 14.0, *)) {
        [types addObject:AVCaptureDeviceTypeExternal];
        [types addObject:AVCaptureDeviceTypeContinuityCamera];
    }
#else
    if (@available(iOS 17.0, *)) [types addObject:AVCaptureDeviceTypeExternal]; // USB cameras on iPad
#endif
    AVCaptureDeviceDiscoverySession *ds =
        [AVCaptureDeviceDiscoverySession discoverySessionWithDeviceTypes:types
                                                               mediaType:AVMediaTypeVideo
                                                                position:AVCaptureDevicePositionUnspecified];
#if TARGET_OS_OSX
    return ds.devices;
#else
    // A call wants the front camera: list it first (the default picks the
    // first built-in one).
    return [ds.devices sortedArrayUsingComparator:^NSComparisonResult(AVCaptureDevice *a, AVCaptureDevice *b) {
      BOOL fa = a.position == AVCaptureDevicePositionFront, fb = b.position == AVCaptureDevicePositionFront;
      return fa == fb ? NSOrderedSame : fa ? NSOrderedAscending : NSOrderedDescending;
    }];
#endif
}

// clamshellClosed: the MacBook lid is closed (IOPMrootDomain's
// AppleClamshellState). Used for the built-in camera before macOS 14,
// which has no -[AVCaptureDevice isSuspended].
static BOOL clamshellClosed(void) {
#if !TARGET_OS_OSX
    return NO;
#else
    io_service_t root = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching("IOPMrootDomain"));
    if (!root) return NO;
    CFTypeRef v = IORegistryEntryCreateCFProperty(root, CFSTR("AppleClamshellState"), kCFAllocatorDefault, 0);
    IOObjectRelease(root);
    BOOL closed = v && CFGetTypeID(v) == CFBooleanGetTypeID() && CFBooleanGetValue((CFBooleanRef)v);
    if (v) CFRelease(v);
    return closed;
#endif
}

char *qv_camera_list(char **err) {
    NSMutableArray *out = [NSMutableArray array];
    for (AVCaptureDevice *d in cameras()) {
        NSMutableDictionary *best = [NSMutableDictionary dictionary]; // "WxH" -> max fps
        for (AVCaptureDeviceFormat *f in d.formats) {
            CMVideoDimensions dim = CMVideoFormatDescriptionGetDimensions(f.formatDescription);
            double maxFPS = 0;
            for (AVFrameRateRange *r in f.videoSupportedFrameRateRanges) maxFPS = MAX(maxFPS, r.maxFrameRate);
            NSString *k = [NSString stringWithFormat:@"%dx%d", dim.width, dim.height];
            if ([best[k] doubleValue] < maxFPS) best[k] = @(maxFPS);
        }
        NSMutableArray *formats = [NSMutableArray array];
        for (NSString *k in best) {
            NSArray *wh = [k componentsSeparatedByString:@"x"];
            [formats addObject:@{@"width" : @([wh[0] intValue]), @"height" : @([wh[1] intValue]),
                                 @"max_fps" : @((int)round([best[k] doubleValue]))}];
        }
        NSString *kind = @"external";
#if TARGET_OS_OSX
        // transportType tells virtual cameras ('virt': OBS, Immersed...) from
        // real ones ('usb ', 'bltn'); iPhones report 'othr'.
        int32_t transport = d.transportType;
        if ([d.deviceType isEqualToString:AVCaptureDeviceTypeBuiltInWideAngleCamera] || transport == 'bltn') kind = @"builtin";
        else if (transport == 'virt') kind = @"virtual";
        else if (transport == 'othr') kind = @"continuity";
        if (@available(macOS 14.0, *)) {
            if ([d.deviceType isEqualToString:AVCaptureDeviceTypeContinuityCamera]) kind = @"continuity";
        }
#else
        if ([d.deviceType isEqualToString:AVCaptureDeviceTypeBuiltInWideAngleCamera]) kind = @"builtin";
#endif
        // A closed MacBook lid suspends the built-in camera: it's still
        // listed (even as the default) but delivers no frames.
        NSString *unavailable = @"";
        BOOL suspended = NO;
#if TARGET_OS_OSX
        if (@available(macOS 14.0, *)) suspended = d.isSuspended;
#endif
        if ([kind isEqualToString:@"builtin"] && (suspended || clamshellClosed())) {
            unavailable = @"the built-in camera is off while the lid is closed";
        } else if (suspended) {
            unavailable = @"the camera is suspended";
        }
        NSString *facing = d.position == AVCaptureDevicePositionFront ? @"front"
                           : d.position == AVCaptureDevicePositionBack ? @"back" : @"";
        [out addObject:@{@"id" : d.uniqueID, @"name" : d.localizedName, @"kind" : kind, @"formats" : formats,
                         @"unavailable" : unavailable, @"facing" : facing}];
    }
    return jsonString(out);
}

@interface QVCameraOutput : NSObject <AVCaptureVideoDataOutputSampleBufferDelegate>
@property(atomic) uintptr_t handle;
#if !TARGET_OS_OSX
// Follows how the phone is held, so the picture is sent upright.
@property(nonatomic, weak) AVCaptureConnection *conn;
@property(nonatomic, strong) id rotator;   // AVCaptureDeviceRotationCoordinator (iOS 17+)
@property(nonatomic, strong) id orientTok; // UIDeviceOrientationDidChange observer (iOS 16)
#endif
@end

@implementation QVCameraOutput
- (void)captureOutput:(AVCaptureOutput *)output
    didOutputSampleBuffer:(CMSampleBufferRef)sb
           fromConnection:(AVCaptureConnection *)connection {
    CVImageBufferRef pb = CMSampleBufferGetImageBuffer(sb);
    if (pb && self.handle) qvGoCameraFrame(self.handle, (void *)pb, nowUS());
}
#if !TARGET_OS_OSX
- (void)observeValueForKeyPath:(NSString *)keyPath ofObject:(id)object change:(NSDictionary *)change context:(void *)context {
    if (@available(iOS 17.0, *)) {
        CGFloat a = ((AVCaptureDeviceRotationCoordinator *)object).videoRotationAngleForHorizonLevelCapture;
        AVCaptureConnection *c = self.conn;
        if (c && [c isVideoRotationAngleSupported:a]) c.videoRotationAngle = a;
    }
}
#endif
@end

#if !TARGET_OS_OSX
static NSString *const kHorizonAngle = @"videoRotationAngleForHorizonLevelCapture";

// iOS 16: the device's orientation as a capture orientation (the landscape
// names are swapped between the two: the device's is where the home
// button side points, the capture's where the top of the picture goes).
static void applyDeviceOrientation(AVCaptureConnection *c) {
    if (!c.isVideoOrientationSupported) return;
    switch (UIDevice.currentDevice.orientation) {
    case UIDeviceOrientationPortrait: c.videoOrientation = AVCaptureVideoOrientationPortrait; break;
    case UIDeviceOrientationPortraitUpsideDown: c.videoOrientation = AVCaptureVideoOrientationPortraitUpsideDown; break;
    case UIDeviceOrientationLandscapeLeft: c.videoOrientation = AVCaptureVideoOrientationLandscapeRight; break;
    case UIDeviceOrientationLandscapeRight: c.videoOrientation = AVCaptureVideoOrientationLandscapeLeft; break;
    default: break; // face up or down: keep the last one
    }
}
#endif

struct qv_camera {
    void *session;   // AVCaptureSession (retained)
    void *output;    // QVCameraOutput (retained)
    void *video;     // AVCaptureVideoDataOutput (retained)
    void *queue;     // its sample buffer queue (retained)
    void *observers; // NSArray of NotificationCenter tokens (retained)
};

qv_camera *qv_camera_start(const char *unique_id, int width, int height, int fps, uintptr_t handle, char **err) {
    AVCaptureDevice *dev = nil;
    NSString *want = unique_id && unique_id[0] ? [NSString stringWithUTF8String:unique_id] : nil;
    for (AVCaptureDevice *d in cameras()) {
        if (want == nil || [d.uniqueID isEqualToString:want]) {
            dev = d;
            break;
        }
    }
    if (want == nil) dev = [AVCaptureDevice defaultDeviceWithMediaType:AVMediaTypeVideo] ?: dev;
    if (dev == nil) {
        *err = strdup(want ? "no camera with that id" : "no camera found");
        return NULL;
    }
    // Closest format by pixel count that supports the frame rate.
    AVCaptureDeviceFormat *pick = nil;
    double bestScore = 1e18;
    for (AVCaptureDeviceFormat *f in dev.formats) {
        CMVideoDimensions dim = CMVideoFormatDescriptionGetDimensions(f.formatDescription);
        double maxFPS = 0;
        for (AVFrameRateRange *r in f.videoSupportedFrameRateRanges) maxFPS = MAX(maxFPS, r.maxFrameRate);
        double score = fabs((double)dim.width * dim.height - (double)width * height) + (maxFPS + 0.5 < fps ? 1e12 : 0);
        if (score < bestScore) {
            bestScore = score;
            pick = f;
        }
    }
    NSError *e = nil;
    AVCaptureDeviceInput *in = [AVCaptureDeviceInput deviceInputWithDevice:dev error:&e];
    if (in == nil) {
        *err = nserr(@"opening the camera failed", e);
        return NULL;
    }
    AVCaptureSession *session = [[AVCaptureSession alloc] init];
#if !TARGET_OS_OSX
    // Leave the app's audio session alone: voice runs its own
    // (voice processing, echo cancellation) and capture has no audio.
    session.automaticallyConfiguresApplicationAudioSession = NO;
#endif
    [session beginConfiguration];
    if (![session canAddInput:in]) {
        *err = strdup("cannot use this camera");
        return NULL;
    }
    [session addInput:in];
    if (pick && [dev lockForConfiguration:&e]) {
        dev.activeFormat = pick;
        for (AVFrameRateRange *r in pick.videoSupportedFrameRateRanges) {
            if (r.minFrameRate <= fps && fps <= r.maxFrameRate) {
                dev.activeVideoMinFrameDuration = CMTimeMake(1, fps);
                dev.activeVideoMaxFrameDuration = CMTimeMake(1, fps);
            }
        }
        [dev unlockForConfiguration];
    }
    AVCaptureVideoDataOutput *vo = [[AVCaptureVideoDataOutput alloc] init];
    vo.videoSettings = @{(__bridge NSString *)kCVPixelBufferPixelFormatTypeKey : @(kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange)};
    vo.alwaysDiscardsLateVideoFrames = YES;
    QVCameraOutput *out = [[QVCameraOutput alloc] init];
    out.handle = handle;
    dispatch_queue_t q = dispatch_queue_create("quicvideo.camera", DISPATCH_QUEUE_SERIAL);
    [vo setSampleBufferDelegate:out queue:q];
    if (![session canAddOutput:vo]) {
        *err = strdup("cannot capture from this camera");
        return NULL;
    }
    [session addOutput:vo];
#if !TARGET_OS_OSX
    AVCaptureConnection *conn = [vo connectionWithMediaType:AVMediaTypeVideo];
    // What's sent is never mirrored, front camera included, so text held up
    // reads right for the others. (The app mirrors only its own preview of
    // the front camera, as FaceTime does.)
    if (conn.isVideoMirroringSupported) {
        conn.automaticallyAdjustsVideoMirroring = NO;
        conn.videoMirrored = NO;
    }
    // Upright for however the phone is held (portrait, either landscape,
    // upside down), the front camera's angles included; it follows turns.
    out.conn = conn;
    if (@available(iOS 17.0, *)) {
        AVCaptureDeviceRotationCoordinator *rc = [[AVCaptureDeviceRotationCoordinator alloc] initWithDevice:dev previewLayer:nil];
        out.rotator = rc;
        CGFloat a = rc.videoRotationAngleForHorizonLevelCapture;
        if ([conn isVideoRotationAngleSupported:a]) conn.videoRotationAngle = a;
        [rc addObserver:out forKeyPath:kHorizonAngle options:NSKeyValueObservingOptionNew context:NULL];
    } else {
        if (conn.isVideoOrientationSupported) conn.videoOrientation = AVCaptureVideoOrientationPortrait;
        dispatch_async(dispatch_get_main_queue(), ^{
          [UIDevice.currentDevice beginGeneratingDeviceOrientationNotifications];
          applyDeviceOrientation(conn);
        });
        __weak AVCaptureConnection *wconn = conn;
        out.orientTok = [[NSNotificationCenter defaultCenter] addObserverForName:UIDeviceOrientationDidChangeNotification object:nil
                                                                           queue:[NSOperationQueue mainQueue]
                                                                      usingBlock:^(NSNotification *n) {
                                                                        AVCaptureConnection *c = wconn;
                                                                        if (c) applyDeviceOrientation(c);
                                                                      }];
    }
#endif
    [session commitConfiguration];
    [session startRunning];
    if (!session.running) {
        *err = strdup("the camera did not start (in use by another app, or not permitted)");
        return NULL;
    }
    // The camera can end on its own: a runtime error, or the device going
    // away (unplugged, Continuity iPhone out of reach). Reported once; Stop
    // removes the observers first, so its own teardown isn't reported.
    NSNotificationCenter *nc = [NSNotificationCenter defaultCenter];
    __weak QVCameraOutput *wout = out; // handle is 0 once Stop began
    id errTok = [nc addObserverForName:AVCaptureSessionRuntimeErrorNotification object:session queue:nil
                            usingBlock:^(NSNotification *n) {
                              uintptr_t h = wout.handle;
                              NSError *e = n.userInfo[AVCaptureSessionErrorKey];
                              if (h) qvGoCameraStopped(h, nserr(@"camera error", e));
                            }];
    id goneTok = [nc addObserverForName:AVCaptureDeviceWasDisconnectedNotification object:dev queue:nil
                             usingBlock:^(NSNotification *n) {
                               uintptr_t h = wout.handle;
                               if (h) qvGoCameraStopped(h, strdup("the camera was disconnected"));
                             }];
#if !TARGET_OS_OSX
    // iOS takes the camera away when the app goes to the background, or
    // for another app's video: the share ends (turn it on again after).
    id pausedTok = [nc addObserverForName:AVCaptureSessionWasInterruptedNotification object:session queue:nil
                               usingBlock:^(NSNotification *n) {
                                 uintptr_t h = wout.handle;
                                 if (h) qvGoCameraStopped(h, strdup("the camera was interrupted (app in the background, or in use)"));
                               }];
#endif
    qv_camera *c = calloc(1, sizeof(*c));
    c->session = (__bridge_retained void *)session;
    c->output = (__bridge_retained void *)out;
    c->video = (__bridge_retained void *)vo;
    c->queue = (__bridge_retained void *)q;
#if TARGET_OS_OSX
    c->observers = (__bridge_retained void *)@[ errTok, goneTok ];
#else
    c->observers = (__bridge_retained void *)@[ errTok, goneTok, pausedTok ];
#endif
    return c;
}

// qv_camera_stop releases the camera: the session stops (the camera light
// goes off), the delegate is detached and its queue drained, so no frame
// reaches Go after this returns.
void qv_camera_stop(qv_camera *c) {
    if (c == NULL) return;
    AVCaptureSession *session = (__bridge_transfer AVCaptureSession *)c->session;
    QVCameraOutput *out = (__bridge_transfer QVCameraOutput *)c->output;
    AVCaptureVideoDataOutput *vo = (__bridge_transfer AVCaptureVideoDataOutput *)c->video;
    dispatch_queue_t q = (__bridge_transfer dispatch_queue_t)c->queue;
    NSArray *observers = (__bridge_transfer NSArray *)c->observers;
    out.handle = 0; // late frames and notifications are dropped from here on
    for (id tok in observers) [[NSNotificationCenter defaultCenter] removeObserver:tok];
#if !TARGET_OS_OSX
    if (out.rotator) {
        [out.rotator removeObserver:out forKeyPath:kHorizonAngle];
        out.rotator = nil;
    }
    if (out.orientTok) {
        [[NSNotificationCenter defaultCenter] removeObserver:out.orientTok];
        out.orientTok = nil;
        dispatch_async(dispatch_get_main_queue(), ^{ [UIDevice.currentDevice endGeneratingDeviceOrientationNotifications]; });
    }
#endif
    [session stopRunning];
    [vo setSampleBufferDelegate:nil queue:nil];
    dispatch_sync(q, ^{});
    out.handle = 0;
    [session beginConfiguration];
    for (AVCaptureInput *in in session.inputs) [session removeInput:in];
    for (AVCaptureOutput *o in session.outputs) [session removeOutput:o];
    [session commitConfiguration];
    free(c);
}
