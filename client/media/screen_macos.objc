// Screen capture (ScreenCaptureKit, macOS 12.3+) and its TCC permission.
// macOS only: included by capture_darwin.objc when TARGET_OS_OSX.

int qv_screen_access(void) { return CGPreflightScreenCaptureAccess() ? 1 : -1; }

void qv_screen_request(void) { CGRequestScreenCaptureAccess(); }

// ---------------------------------------------------------------- screen

// ScreenCaptureKit is weak-linked (macOS 12.3+): apps built for an older
// minimum still launch there, without screen sharing.
int qv_screen_supported(void) {
    if (@available(macOS 12.3, *)) return 1;
    return 0;
}

static SCShareableContent *shareableContent(NSError **outErr) API_AVAILABLE(macos(12.3));
static SCShareableContent *shareableContent(NSError **outErr) {
    __block SCShareableContent *content = nil;
    __block NSError *error = nil;
    dispatch_semaphore_t sem = dispatch_semaphore_create(0);
    [SCShareableContent getShareableContentExcludingDesktopWindows:YES
                                               onScreenWindowsOnly:YES
                                                 completionHandler:^(SCShareableContent *c, NSError *e) {
                                                   content = c;
                                                   error = e;
                                                   dispatch_semaphore_signal(sem);
                                                 }];
    if (dispatch_semaphore_wait(sem, dispatch_time(DISPATCH_TIME_NOW, 10 * NSEC_PER_SEC)) != 0) {
        *outErr = [NSError errorWithDomain:@"qv" code:-1 userInfo:@{NSLocalizedDescriptionKey : @"timed out"}];
        return nil;
    }
    *outErr = error;
    return content;
}

static void displayPixels(CGDirectDisplayID d, int *w, int *h) {
    CGDisplayModeRef mode = CGDisplayCopyDisplayMode(d);
    *w = (int)CGDisplayModeGetPixelWidth(mode);
    *h = (int)CGDisplayModeGetPixelHeight(mode);
    CGDisplayModeRelease(mode);
}

static char *screenList(char **err) API_AVAILABLE(macos(12.3)) {
    NSError *e = nil;
    SCShareableContent *c = shareableContent(&e);
    if (c == nil) {
        *err = nserr(@"listing screens failed", e);
        return NULL;
    }
    pid_t me = getpid();
    NSMutableArray *displays = [NSMutableArray array];
    for (SCDisplay *d in c.displays) {
        int w, h;
        displayPixels(d.displayID, &w, &h);
        // One of our own windows is on it: sharing it shows the call
        // inside the share (the windows themselves are left out).
        BOOL hasSelf = NO;
        for (SCWindow *win in c.windows) {
            if (win.owningApplication.processID == me && win.windowLayer == 0 && CGRectIntersectsRect(win.frame, d.frame)) hasSelf = YES;
        }
        [displays addObject:@{
            @"id" : @(d.displayID), @"width" : @(w), @"height" : @(h),
            @"main" : (d.displayID == CGMainDisplayID() ? @YES : @NO), @"has_self" : @(hasSelf)
        }];
    }
    NSMutableArray *windows = [NSMutableArray array];
    for (SCWindow *w in c.windows) {
        if (w.windowLayer != 0 || w.frame.size.width < 64 || w.frame.size.height < 64) continue; // normal windows
        if (w.owningApplication.processID == me) continue;                                       // not our own
        [windows addObject:@{
            @"id" : @(w.windowID), @"title" : w.title ?: @"", @"app" : w.owningApplication.applicationName ?: @"",
            @"bundle_id" : w.owningApplication.bundleIdentifier ?: @"",
            @"width" : @((int)w.frame.size.width), @"height" : @((int)w.frame.size.height)
        }];
    }
    return jsonString(@{@"displays" : displays, @"windows" : windows});
}

char *qv_screen_list(char **err) {
    if (@available(macOS 12.3, *)) return screenList(err);
    *err = strdup("screen sharing needs macOS 12.3 or later");
    return NULL;
}

API_AVAILABLE(macos(12.3))
@interface QVScreenOutput : NSObject <SCStreamOutput, SCStreamDelegate>
@property(atomic) uintptr_t handle;
@end

// presentationUS is when the frame was on screen, as wall-clock µs: its
// presentation time on the host clock (exact display refreshes, 33.3 ms
// apart at 30 fps), not when the callback ran (which wanders by several
// ms). Receivers pace frames by this, so even timestamps mean even motion.
static uint64_t presentationUS(CMSampleBufferRef sb) {
    uint64_t now = nowUS();
    CMTime pts = CMSampleBufferGetPresentationTimeStamp(sb);
    if (!CMTIME_IS_NUMERIC(pts)) return now;
    double ago = CMTimeGetSeconds(CMTimeSubtract(CMClockGetTime(CMClockGetHostTimeClock()), pts));
    if (ago < 0 || ago > 0.5) return now; // not the host clock after all
    return now - (uint64_t)(ago * 1e6);
}

@implementation QVScreenOutput
- (void)stream:(SCStream *)stream didOutputSampleBuffer:(CMSampleBufferRef)sb ofType:(SCStreamOutputType)type {
    if (type != SCStreamOutputTypeScreen || !CMSampleBufferIsValid(sb)) return;
    CFArrayRef atts = CMSampleBufferGetSampleAttachmentsArray(sb, false);
    if (atts == NULL || CFArrayGetCount(atts) == 0) return;
    NSDictionary *info = (__bridge NSDictionary *)CFArrayGetValueAtIndex(atts, 0);
    NSNumber *status = info[SCStreamFrameInfoStatus];
    // Idle = nothing changed since the last frame: no new image, nothing to
    // encode. A static screen costs (almost) nothing.
    if (status == nil || status.integerValue != SCFrameStatusComplete) return;
    CVImageBufferRef pb = CMSampleBufferGetImageBuffer(sb);
    if (pb == NULL) return;
    if (self.handle) qvGoScreenFrame(self.handle, (void *)pb, presentationUS(sb));
}
- (void)stream:(SCStream *)stream didStopWithError:(NSError *)error {
    if (self.handle) qvGoScreenStopped(self.handle, (int)error.code, nserr(@"screen capture stopped", error));
}
@end

struct qv_screen {
    void *stream; // SCStream (retained)
    void *output; // QVScreenOutput (retained)
    void *queue;  // its sample handler queue (retained)
};

static qv_screen *screenStart(uint32_t display_id, uint32_t window_id, int width, int height, int max_width, int fps, int show_cursor,
                           uintptr_t handle, char **err) API_AVAILABLE(macos(12.3)) {
    NSError *e = nil;
    SCShareableContent *c = shareableContent(&e);
    if (c == nil) {
        *err = nserr(@"screen capture unavailable", e);
        return NULL;
    }
    SCContentFilter *filter = nil;
    int nw = 0, nh = 0;
    if (window_id) {
        for (SCWindow *w in c.windows) {
            if (w.windowID == window_id) {
                filter = [[SCContentFilter alloc] initWithDesktopIndependentWindow:w];
                CGFloat scale = NSScreen.mainScreen.backingScaleFactor;
                nw = (int)(w.frame.size.width * scale);
                nh = (int)(w.frame.size.height * scale);
            }
        }
    } else {
        CGDirectDisplayID want = display_id ? display_id : CGMainDisplayID();
        for (SCDisplay *d in c.displays) {
            if (d.displayID == want) {
                // Our own windows are left out of the share (no call inside
                // the call).
                NSMutableArray *own = [NSMutableArray array];
                for (SCRunningApplication *app in c.applications) {
                    if (app.processID == getpid()) [own addObject:app];
                }
                filter = [[SCContentFilter alloc] initWithDisplay:d excludingApplications:own exceptingWindows:@[]];
                displayPixels(d.displayID, &nw, &nh);
            }
        }
    }
    if (filter == nil) {
        *err = strdup("no such display or window");
        return NULL;
    }
    if (width <= 0 || height <= 0) {
        // A window: its own pixels, but no wider than max_width (a Retina
        // window is often 2500+ wide, scaled down to 1920 by the encoder
        // anyway: capturing it full size costs GPU and time per frame).
        width = nw;
        height = nh;
        if (max_width > 0 && width > max_width) {
            height = (int)((double)height * max_width / width);
            width = max_width;
        }
    }
    SCStreamConfiguration *cfg = [[SCStreamConfiguration alloc] init];
    cfg.width = (size_t)(width & ~1);
    cfg.height = (size_t)(height & ~1);
    cfg.minimumFrameInterval = CMTimeMake(1, fps > 0 ? fps : 15);
    cfg.pixelFormat = kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange; // what the encoder wants
    cfg.showsCursor = show_cursor ? YES : NO;
    cfg.queueDepth = 5;
    cfg.scalesToFit = YES;

    QVScreenOutput *out = [[QVScreenOutput alloc] init];
    out.handle = handle;
    SCStream *stream = [[SCStream alloc] initWithFilter:filter configuration:cfg delegate:out];
    dispatch_queue_t q = dispatch_queue_create("quicvideo.screen", DISPATCH_QUEUE_SERIAL);
    if (![stream addStreamOutput:out type:SCStreamOutputTypeScreen sampleHandlerQueue:q error:&e]) {
        *err = nserr(@"addStreamOutput failed", e);
        return NULL;
    }
    __block NSError *startErr = nil;
    dispatch_semaphore_t sem = dispatch_semaphore_create(0);
    [stream startCaptureWithCompletionHandler:^(NSError *se) {
      startErr = se;
      dispatch_semaphore_signal(sem);
    }];
    dispatch_semaphore_wait(sem, dispatch_time(DISPATCH_TIME_NOW, 10 * NSEC_PER_SEC));
    if (startErr) {
        *err = nserr(@"starting screen capture failed", startErr);
        return NULL;
    }
    qv_screen *s = calloc(1, sizeof(*s));
    s->stream = (__bridge_retained void *)stream;
    s->output = (__bridge_retained void *)out;
    s->queue = (__bridge_retained void *)q;
    return s;
}

qv_screen *qv_screen_start(uint32_t display_id, uint32_t window_id, int width, int height, int max_width, int fps, int show_cursor,
                           uintptr_t handle, char **err) {
    if (@available(macOS 12.3, *)) return screenStart(display_id, window_id, width, height, max_width, fps, show_cursor, handle, err);
    *err = strdup("screen sharing needs macOS 12.3 or later");
    return NULL;
}

static void screenStop(qv_screen *s) API_AVAILABLE(macos(12.3)) {
    if (s == NULL) return;
    SCStream *stream = (__bridge_transfer SCStream *)s->stream;
    QVScreenOutput *out = (__bridge_transfer QVScreenOutput *)s->output;
    out.handle = 0; // our own stop isn't "the share ended"; late frames are dropped
    dispatch_semaphore_t sem = dispatch_semaphore_create(0);
    [stream stopCaptureWithCompletionHandler:^(NSError *e) {
      dispatch_semaphore_signal(sem);
    }];
    dispatch_semaphore_wait(sem, dispatch_time(DISPATCH_TIME_NOW, 5 * NSEC_PER_SEC));
    [stream removeStreamOutput:out type:SCStreamOutputTypeScreen error:nil];
    // A frame already on the handler queue would call into Go after Stop
    // deleted its handle: wait for the queue to drain.
    dispatch_queue_t q = (__bridge_transfer dispatch_queue_t)s->queue;
    dispatch_sync(q, ^{});
    out.handle = 0;
    free(s);
}

void qv_screen_stop(qv_screen *s) {
    if (@available(macOS 12.3, *)) screenStop(s); // only ever started on 12.3+
}


// ---------------------------------------------------------------- picker

// qv_app_icon: an app's icon as PNG (size×size), for the picker's window
// list. NULL if the app isn't found.
unsigned char *qv_app_icon(const char *bundle_id, int size, size_t *len) {
    @autoreleasepool {
        NSString *bid = [NSString stringWithUTF8String:bundle_id];
        NSURL *url = [[NSWorkspace sharedWorkspace] URLForApplicationWithBundleIdentifier:bid];
        if (url == nil) return NULL;
        NSImage *icon = [[NSWorkspace sharedWorkspace] iconForFile:url.path];
        NSBitmapImageRep *rep = [[NSBitmapImageRep alloc] initWithBitmapDataPlanes:NULL pixelsWide:size pixelsHigh:size
                                                                     bitsPerSample:8 samplesPerPixel:4 hasAlpha:YES isPlanar:NO
                                                                    colorSpaceName:NSDeviceRGBColorSpace bytesPerRow:0 bitsPerPixel:0];
        [NSGraphicsContext saveGraphicsState];
        [NSGraphicsContext setCurrentContext:[NSGraphicsContext graphicsContextWithBitmapImageRep:rep]];
        [icon drawInRect:NSMakeRect(0, 0, size, size) fromRect:NSZeroRect operation:NSCompositingOperationCopy fraction:1];
        [NSGraphicsContext restoreGraphicsState];
        NSData *png = [rep representationUsingType:NSBitmapImageFileTypePNG properties:@{}];
        if (png.length == 0) return NULL;
        unsigned char *out = malloc(png.length);
        memcpy(out, png.bytes, png.length);
        *len = png.length;
        return out;
    }
}

static unsigned char *thumbnail(uint32_t display_id, uint32_t window_id, int max_w, size_t *len, char **err) API_AVAILABLE(macos(14.0)) {
    NSError *e = nil;
    SCShareableContent *c = shareableContent(&e);
    if (c == nil) {
        *err = nserr(@"listing screens failed", e);
        return NULL;
    }
    SCContentFilter *filter = nil;
    CGFloat w = 0, h = 0;
    if (window_id) {
        for (SCWindow *win in c.windows) {
            if (win.windowID == window_id) {
                filter = [[SCContentFilter alloc] initWithDesktopIndependentWindow:win];
                w = win.frame.size.width;
                h = win.frame.size.height;
            }
        }
    } else {
        NSMutableArray *own = [NSMutableArray array];
        for (SCRunningApplication *app in c.applications) {
            if (app.processID == getpid()) [own addObject:app];
        }
        for (SCDisplay *d in c.displays) {
            if (d.displayID == display_id) {
                filter = [[SCContentFilter alloc] initWithDisplay:d excludingApplications:own exceptingWindows:@[]];
                w = d.width;
                h = d.height;
            }
        }
    }
    if (filter == nil || w <= 0 || h <= 0) {
        *err = strdup("no such display or window");
        return NULL;
    }
    SCStreamConfiguration *cfg = [[SCStreamConfiguration alloc] init];
    CGFloat s = MIN(1.0, (CGFloat)max_w / w);
    cfg.width = (size_t)MAX(2, w * s);
    cfg.height = (size_t)MAX(2, h * s);
    cfg.showsCursor = NO;
    __block CGImageRef img = NULL;
    __block NSError *ce = nil;
    dispatch_semaphore_t sem = dispatch_semaphore_create(0);
    [SCScreenshotManager captureImageWithFilter:filter configuration:cfg completionHandler:^(CGImageRef i, NSError *er) {
      if (i) img = CGImageRetain(i);
      ce = er;
      dispatch_semaphore_signal(sem);
    }];
    if (dispatch_semaphore_wait(sem, dispatch_time(DISPATCH_TIME_NOW, 3 * NSEC_PER_SEC)) != 0 || img == NULL) {
        *err = ce ? nserr(@"thumbnail failed", ce) : strdup("thumbnail timed out");
        return NULL;
    }
    NSBitmapImageRep *rep = [[NSBitmapImageRep alloc] initWithCGImage:img];
    CGImageRelease(img);
    NSData *jpg = [rep representationUsingType:NSBitmapImageFileTypeJPEG properties:@{NSImageCompressionFactor : @0.7}];
    unsigned char *out = malloc(jpg.length);
    memcpy(out, jpg.bytes, jpg.length);
    *len = jpg.length;
    return out;
}

// qv_screen_thumbnail: one small JPEG of a display (our own windows left
// out) or a window, at most max_w wide. macOS 14+ (SCScreenshotManager).
unsigned char *qv_screen_thumbnail(uint32_t display_id, uint32_t window_id, int max_w, size_t *len, char **err) {
    if (@available(macOS 14.0, *)) return thumbnail(display_id, window_id, max_w, len, err);
    *err = strdup("thumbnails need macOS 14 or later");
    return NULL;
}
